PORT=3000
# Shared secret the Sarvam agent sends as "Authorization: Bearer <secret>" (or X-API-Key).
# Leave empty to disable auth on the /api/sarvam and /api/tools endpoints (local testing only).
WEBHOOK_SECRET=
# Password for the dashboard (browser login, any username). Leave empty to disable.
DASHBOARD_PASSWORD=
# Extra named logins as username:password pairs, comma separated (e.g. test:secret1,manager:secret2).
DASHBOARD_USERS=
RESTAURANT_NAME=SpiceGarden
TIME_ZONE=Asia/Kolkata
SEAT_CAPACITY=40
BOOKING_DURATION_MIN=90
OPENING_HOURS=12:00-15:30,19:00-23:00
# Reject place_order when an item doesn't match the menu (default: accept and flag it on the dashboard)
REJECT_UNKNOWN_ITEMS=false
# Optional: send real confirmation SMS through Twilio. Without these, SMS are only logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Storage: set all three SUPABASE_* values to use Supabase (required on Vercel).
# Otherwise orders are kept in DATA_FILE. Schema: supabase/migrations/.
SUPABASE_URL=
# The project's publishable key (sb_publishable_...). Safe on its own: RLS blocks it without the app secret.
SUPABASE_KEY=
# Must match private.app_config.app_secret in the database (32+ characters).
SUPABASE_APP_SECRET=
DATA_FILE=./data/db.json
