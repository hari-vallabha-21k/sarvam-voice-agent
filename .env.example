PORT=3000
# Shared secret the Sarvam agent sends as "Authorization: Bearer <secret>" (or X-API-Key).
# Leave empty to disable auth on the /api/sarvam and /api/tools endpoints (local testing only).
WEBHOOK_SECRET=
RESTAURANT_NAME=SpiceGarden
TIME_ZONE=Asia/Kolkata
SEAT_CAPACITY=40
BOOKING_DURATION_MIN=90
OPENING_HOURS=12:00-15:30,19:00-23:00
# Reject place_order when an item doesn't match the menu (default: accept and flag it on the dashboard)
REJECT_UNKNOWN_ITEMS=false
# Optional: send real confirmation SMS through Twilio. Without these, SMS are only logged.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DATA_FILE=./data/db.json
