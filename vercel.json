{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p dist",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "includeFiles": "public/**", "maxDuration": 15 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
